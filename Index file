<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>पढ़ाई साथी - कक्षा 1 से 10</title>
    <style>
        * { box-sizing: border-box; font-family: Arial, sans-serif; margin: 0; padding: 0; }
        body { background-color: #f4f7f6; padding: 15px; }
        header { background: #4A90E2; color: white; padding: 15px; text-align: center; font-size: 22px; font-weight: bold; border-radius: 8px; }
        .container { max-width: 800px; margin: 15px auto; }
        .title { margin: 15px 0 8px; font-weight: bold; color: #333; }
        
        /* बटन स्टाइल */
        .btn-group { display: flex; flex-wrap: wrap; gap: 8px; }
        .btn { background: white; border: 2px solid #ddd; padding: 10px 14px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 14px; }
        .btn:hover { background: #e0e0e0; }
        .btn.active { background: #4A90E2; color: white; border-color: #4A90E2; }
        
        /* कंटेंट बॉक्स */
        .content-box { background: white; margin-top: 20px; padding: 20px; border-radius: 8px; border: 1px solid #ccc; min-height: 200px; }
        .content-title { color: #4A90E2; border-bottom: 2px solid #4A90E2; padding-bottom: 5px; margin-bottom: 15px; font-size: 18px; }
        .lesson-card { background: #f9f9f9; border-left: 4px solid #4A90E2; padding: 12px; margin-bottom: 12px; border-radius: 4px; }
        .lesson-card h4 { color: #333; margin-bottom: 5px; font-size: 16px; }
        .lesson-card p { color: #555; font-size: 14px; line-height: 1.4; }
    </style>
</head>
<body>

<header>📚 पढ़ाई साथी (Study Companion)</header>

<div class="container">
    <!-- 1. कक्षा चुनना -->
    <div class="title">1. कक्षा चुनें (Select Class):</div>
    <div class="btn-group" id="class-buttons"></div>

    <!-- 2. विषय चुनना -->
    <div class="title">2. विषय चुनें (Select Subject):</div>
    <div class="btn-group" id="subject-buttons"></div>

    <!-- 3. पढ़ाई की सामग्री -->
    <div class="content-box">
        <h3 class="content-title" id="display-title">कक्षा 1 - हिंदी</h3>
        <div id="display-content"></div>
    </div>
</div>

<script>
    // डेटाबेस (कक्षा 1, 5 और 10 के उदाहरण)
    const database = {
        1: {
            "हिंदी": [
                { title: "अ वर्णमाला", desc: "अ से अनार, आ से आम, इ से इमली, ई से ईख" },
                { title: "क वर्णमाला", desc: "क से कबूतर, ख से खरगोश, ग से गमला, घ से घड़ी" }
            ],
            "इंग्लिश": [
                { title: "Alphabets (A - D)", desc: "A for Apple 🍎, B for Ball ⚽, C for Cat 🐱, D for Dog 🐶" },
                { title: "Alphabets (E - H)", desc: "E for Elephant 🐘, F for Fish 🐟, G for Grapes 🍇, H for Hen 🐔" }
            ],
            "गणित": [
                { title: "गिनती (1 से 5)", desc: "1 - एक, 2 - दो, 3 - तीन, 4 - चार, 5 - पाँच" },
                { title: "आसान जोड़", desc: "1 + 1 = 2 <br> 2 + 1 = 3" }
            ],
            "विज्ञान": [
                { title: "शरीर के अंग", desc: "Eye = आंख <br> Ear = कान <br> Nose = नाक <br> Hand = हाथ" }
            ]
        },
        5: {
            "हिंदी": [
                { title: "व्याकरण - संज्ञा", desc: "किसी व्यक्ति, वस्तु या स्थान के नाम को संज्ञा कहते हैं। उदाहरण: राम, दिल्ली, किताब।" }
            ],
            "इंग्लिश": [
                { title: "Nouns (संज्ञा)", desc: "A Noun is the name of a person, place, or thing. Example: Rahul, India, Book." }
            ],
            "गणित": [
                { title: "भिन्न (Fractions)", desc: "1/2 = आधा, 1/4 = चौथाई, 3/4 = तीन चौथाई" }
            ],
            "विज्ञान": [
                { title: "प्रकाश संश्लेषण (Photosynthesis)", desc: "पौधे सूर्य के प्रकाश और पानी की मदद से अपना भोजन बनाते हैं।" }
            ]
        },
        10: {
            "हिंदी": [
                { title: "व्याकरण - अलंकार", desc: "काव्य की शोभा बढ़ाने वाले तत्वों को अलंकार कहते हैं। (जैसे: अनुप्रास, रूपक, यमक)" }
            ],
            "इंग्लिश": [
                { title: "Tenses (काल)", desc: "Present Continuous Tense: Subject + is/am/are + Verb(ing)" }
            ],
            "गणित": [
                { title: "द्विघात समीकरण", desc: "समीकरण का रूप: ax² + bx + c = 0" }
            ],
            "विज्ञान": [
                { title: "प्रकाश का परावर्तन", desc: "आपतन कोण (Angle of Incidence) = परावर्तन कोण (Angle of Reflection)।" }
            ]
        }
    };

    let selectedClass = 1;
    let selectedSubject = "हिंदी";

    // कक्षा बटन बनाना
    const classContainer = document.getElementById("class-buttons");
    for (let i = 1; i <= 10; i++) {
        const btn = document.createElement("button");
        btn.className = `btn ${i === 1 ? 'active' : ''}`;
        btn.innerText = `कक्षा ${i}`;
        btn.onclick = () => {
            document.querySelectorAll("#class-buttons .btn").forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            selectedClass = i;
            updateDisplay();
        };
        classContainer.appendChild(btn);
    }

    // विषय बटन बनाना
    const subjects = ["हिंदी", "इंग्लिश", "गणित", "विज्ञान"];
    const subjectContainer = document.getElementById("subject-buttons");
    subjects.forEach((sub, index) => {
        const btn = document.createElement("button");
        btn.className = `btn ${index === 0 ? 'active' : ''}`;
        btn.innerText = sub;
        btn.onclick = () => {
            document.querySelectorAll("#subject-buttons .btn").forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            selectedSubject = sub;
            updateDisplay();
        };
        subjectContainer.appendChild(btn);
    });

    // स्क्रीन पर डेटा अपडेट करने का फ़ंक्शन
    function updateDisplay() {
        document.getElementById("display-title").innerText = `कक्षा ${selectedClass} - ${selectedSubject}`;
        const displayContent = document.getElementById("display-content");
        displayContent.innerHTML = "";

        if (database[selectedClass] && database[selectedClass][selectedSubject]) {
            const lessons = database[selectedClass][selectedSubject];
            lessons.forEach(lesson => {
                const card = document.createElement("div");
                card.className = "lesson-card";
                card.innerHTML = `<h4>${lesson.title}</h4><p>${lesson.desc}</p>`;
                displayContent.appendChild(card);
            });
        } else {
            displayContent.innerHTML = `<p style="color: #666; font-style: italic;">कक्षा ${selectedClass} के ${selectedSubject} विषय का डेटा अभी जोड़ा जाना बाकी है। (कक्षा 1, 5 या 10 चुनकर चेक करें)</p>`;
        }
    }

    // पहली बार लोड करने के लिए
    updateDisplay();
</script>

</body>
</html>
